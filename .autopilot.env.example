# autopilot per-repo config — copy to .autopilot.env at your repo root.
# Sourced automatically by the autopilot CLI, so you set these once instead of
# prefixing every command. The `:=` form means an inline env var still wins for
# a one-off (e.g. `AUTOPILOT_LANG=en autopilot supervise ...`).

# Language for reports, inbox items, and the final summary (en | fr | ...).
: "${AUTOPILOT_LANG:=fr}"

# Pin the Claude model (reproducible; dodges a flaky tier). Unset = CLI default.
: "${AUTOPILOT_CLAUDE_MODEL:=claude-opus-4-8}"

# Live play-by-play in the session log (needs jq). 1 = on.
: "${AUTOPILOT_STREAM:=1}"

# Get pinged on DONE / BLOCKED / STUCK from anywhere (https://ntfy.sh/<topic>).
# : "${AUTOPILOT_NTFY_TOPIC:=my-autopilot-abc123}"

# --- Rich per-step notifications: verbosity + Telegram + generic webhook ------
# How much to push: milestones = run DONE/BLOCKED/STUCK + human-blocking only ·
# steps = every gate, verify, review, task done (the deterministic per-step feed) ·
# verbose = adds each decision + task cut (best-effort, emitted by the engine).
# Every event is always recorded to .autopilot/events.log regardless of this.
: "${AUTOPILOT_NOTIFY_LEVEL:=verbose}"

# Telegram (primary rich channel — long markdown messages). Setup:
#   1. message @BotFather → /newbot → copy the token
#   2. message your new bot once, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}
# The token is a secret — this file is gitignored, so it is never committed.
# : "${AUTOPILOT_TELEGRAM_TOKEN:=123456789:ABCdef_your-bot-token}"
# : "${AUTOPILOT_TELEGRAM_CHAT_ID:=123456789}"

# Generic webhook: autopilot POSTs JSON {kind,title,body,task,state,ts} to this URL.
# Point it at n8n / Make / Twilio (for WhatsApp) / your own bot.
# : "${AUTOPILOT_WEBHOOK_URL:=https://example.com/hooks/autopilot}"

# Independent reviewer: codex = a different model reviews the diff. Default subagent.
# : "${AUTOPILOT_REVIEWER:=codex}"
