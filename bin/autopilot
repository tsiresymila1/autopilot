#!/usr/bin/env bash
# autopilot — drive any goal to committed, reviewed code autonomously.
#
#   autopilot doctor [--yes]           preflight: is this project ready? what status?
#   autopilot run "<goal|file>" [opts] one session (needs the claude CLI)
#   autopilot supervise "<goal>" [opts] relaunch across quota resets until DONE/BLOCKED
#   autopilot resume                   resume the run in this repo
#   autopilot status [--json]          aggregate task states from .agent/run/state
#   autopilot scope <task.md> [ref]    changed files outside the task's Allowed Files
#   autopilot review <task.md> [ref]   independent JSON verdict (AUTOPILOT_REVIEWER)
#   autopilot docs [status|init]       the durable-doc quad (committed source of truth)
#   autopilot notify "<title>" "<msg>" fire a milestone notification (test the hook)
#   autopilot update                   pull the latest version and re-link (alias: upgrade)
#   autopilot help
#
# opts forwarded to the skill: --dry-run, --max-tasks N, --yes
set -uo pipefail
# Resolve through symlinks (the installer links this onto PATH) to find the repo.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
HERE="$(cd -P "$(dirname "$src")/.." && pwd)"
LIB="$HERE/lib"
# shellcheck source=lib/common.sh
. "$LIB/common.sh" || { echo "autopilot: cannot load $LIB/common.sh — broken install?" >&2; exit 1; }

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; }

cmd="${1:-help}"; shift 2>/dev/null || true

case "$cmd" in
  doctor)
    bash "$LIB/doctor.sh" "${1:-}" ;;

  run|supervise)
    goal="${1:?usage: autopilot $cmd \"<goal or file>\" [opts]}"; shift || true
    # Preflight gate: block only on hard blockers; pass --yes through.
    yes=""; for a in "$@"; do [ "$a" = "--yes" ] && yes="--yes"; done
    bash "$LIB/doctor.sh" "$yes" || ap_die "doctor blocked the run — fix the ✗ items above, or pass --yes" 3
    if [ "$cmd" = supervise ]; then
      bash "$LIB/supervisor.sh" "$goal" "$@"
    else
      command -v claude >/dev/null 2>&1 || ap_die "claude CLI not on PATH"
      exec claude -p "/autopilot $goal $*" --permission-mode "${PERMISSION_MODE:-bypassPermissions}"
    fi ;;

  resume)
    [ -d "$(ap_queue_dir)" ] || ap_die "no run to resume here (.agent/queue missing)"
    command -v claude >/dev/null 2>&1 || ap_die "claude CLI not on PATH"
    exec claude -p "/autopilot resume the run in .agent/ — read PROGRESS.md and run/state/*, restart at the first task not done" \
      --permission-mode "${PERMISSION_MODE:-bypassPermissions}" ;;

  status)
    # Per-task view: walk the queue, resolve each task's state, tally, print a table.
    sd="$(ap_task_state)"; qd="$(ap_queue_dir)"
    st="$(cat "$(ap_status_file)" 2>/dev/null || echo NONE)"
    json="${1:-}"
    done=0; blocked=0; human=0; todo=0; rows=""; jtasks=""
    icon() { case "$1" in done) echo "✓";; blocked) echo "✗";; needs-human) echo "⚑";; *) echo "·";; esac; }
    if [ -d "$qd" ]; then
      for f in "$qd"/*.md; do
        [ -e "$f" ] || continue
        base="$(basename "$f" .md)"
        title="$(sed -n '1s/^#[[:space:]]*//p' "$f")"; [ -n "$title" ] || title="$base"
        id="$(sed -n 's/^-[[:space:]]*\*\*id\*\*:[[:space:]]*//p' "$f" | head -1)"; [ -n "$id" ] || id="$base"
        gate="$(sed -n 's/^-[[:space:]]*\*\*gate\*\*:[[:space:]]*//p' "$f" | head -1 | tr -d '`')"
        tstate="todo"
        for key in "$id" "$base" "${base%%-*}"; do
          [ -n "$key" ] && [ -f "$sd/$key" ] && { tstate="$(cat "$sd/$key")"; break; }
        done
        case "$tstate" in done) done=$((done+1));; blocked) blocked=$((blocked+1));;
          needs-human) human=$((human+1));; *) todo=$((todo+1)); tstate="todo";; esac
        rows="$rows$(printf '  %s  %-11s %s' "$(icon "$tstate")" "$tstate" "$title")
"
        jtasks="$jtasks,{\"id\":\"$id\",\"state\":\"$tstate\",\"title\":\"${title//\"/\'}\",\"gate\":\"${gate//\"/\'}\"}"
      done
    fi
    if [ "$json" = "--json" ]; then
      printf '{"status":"%s","done":%d,"blocked":%d,"needs_human":%d,"todo":%d,"tasks":[%s]}\n' \
        "$st" "$done" "$blocked" "$human" "$todo" "${jtasks#,}"
    else
      echo "run status: $st"
      echo "$done done · $blocked blocked · $human needs-human · $todo todo"
      [ -n "$rows" ] && { echo; printf '%s' "$rows"; }
      [ -f "$(ap_state_dir)/HUMAN-INBOX.md" ] && { echo; echo "human inbox: $(ap_state_dir)/HUMAN-INBOX.md"; }
      true
    fi ;;

  scope)
    # autopilot scope <task-file.md> [git-ref]
    # Prints changed files outside the task's "## Allowed Files". Exit 2 if any.
    task="${1:?usage: autopilot scope <task-file.md> [git-ref]}"; ref="${2:-HEAD}"
    [ -f "$task" ] || ap_die "no such task file: $task"
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    # Extract bullet paths under "## Allowed Files" until the next "## " heading.
    awk '/^##[[:space:]]+Allowed Files/{f=1;next} /^##[[:space:]]/{f=0} f' "$task" \
      | sed -n 's/^[[:space:]]*[-*][[:space:]]*`\{0,1\}\([^`]*\)`\{0,1\}[[:space:]]*$/\1/p' \
      > "$tmp"
    [ -s "$tmp" ] || ap_die "task has no '## Allowed Files' paths — every task must declare its scope" 2
    v="$(ap_scope_violations "$tmp" "$ref")"
    if [ -n "$v" ]; then
      echo "SCOPE VIOLATION — changed outside ## Allowed Files:"; echo "$v" | sed 's/^/  /'
      exit 2
    fi
    echo "scope ok — all changes within ## Allowed Files" ;;

  review)
    # autopilot review <task-file.md> [git-ref]  — independent JSON verdict.
    # Exit 10 = no external reviewer configured; caller uses the subagent instead.
    bash "$LIB/review.sh" "$@" ;;

  docs)
    # autopilot docs [status|init]  — the durable-doc quad (committed source of truth).
    bash "$LIB/docs.sh" "$@" ;;

  notify)
    # autopilot notify "<title>" "<body>"  — fire a milestone notification (test the hook).
    ap_notify "${1:-autopilot}" "${2:-}" ;;

  update|upgrade)
    # Pull the latest into the install dir (HERE is resolved through the symlink),
    # then re-link so new agents/lib land and extras refresh.
    git -C "$HERE" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      || ap_die "install dir is not a git repo: $HERE — reinstall via the curl one-liner"
    before="$(git -C "$HERE" rev-parse --short HEAD 2>/dev/null)"
    echo "updating $HERE"
    git -C "$HERE" pull --ff-only || ap_die "pull failed (local changes in $HERE?) — stash or reinstall"
    after="$(git -C "$HERE" rev-parse --short HEAD 2>/dev/null)"
    if [ "$before" = "$after" ]; then echo "already up to date ($after)"
    else echo "updated $before → $after"; fi
    bash "$HERE/install.sh" ;;

  help|-h|--help) usage ;;
  *) ap_warn "unknown command: $cmd"; usage; exit 1 ;;
esac
