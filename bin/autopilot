#!/usr/bin/env bash
# autopilot — drive any goal to committed, reviewed code autonomously.
#
#   autopilot doctor [--yes]           preflight: is this project ready? what status?
#   autopilot run "<goal|file>" [opts] one session (needs the claude CLI)
#   autopilot supervise "<goal>" [opts] relaunch across quota resets until DONE/BLOCKED
#   autopilot resume                   resume the run in this repo
#   autopilot status [--json]          aggregate task states from .autopilot/state
#   autopilot verify <task.md> [ref]   two-tier proof: scope + task gate + repo gate
#   autopilot needs-verify <task.md>   documented gate bypass → needs-verification + notify
#   autopilot report <task.md> --state S --did .. --why .. [--how ..] [--notes ..]  per-task report
#   autopilot inbox <task.md> --do .. --why .. [--how ..] [--unblocks ..]           clear human item
#   autopilot gate <task.md> [--repo]  run the task gate (or the repo-wide gate)
#   autopilot gate-lint <task.md>      reject a weak/cheatable gate
#   autopilot scope <task.md> [ref]    changed files outside the task's Allowed Files
#   autopilot revert <task.md>         restore only the task's Allowed Files (scoped)
#   autopilot review <task.md> [ref]   independent JSON verdict (AUTOPILOT_REVIEWER)
#   autopilot event <kind> <title> [body] [--task f] [--state s] [--level l]  per-step notification
#   autopilot init                     scaffold editable project instructions (CLAUDE.md + quad + config)
#   autopilot docs [status|init]       the durable-doc quad (committed source of truth)
#   autopilot logs [what] [-f] [-n N]  tail a log: session (default) | supervisor | gate | journal | ls
#   autopilot notify "<title>" "<msg>" fire a milestone notification (test the hook)
#   autopilot update                   pull the latest version and re-link (alias: upgrade)
#   autopilot help
#
# --print-prompt     show the prompt the engine would receive, start nothing
# --lang <code>      language for reports/inbox/summary (e.g. fr) — or AUTOPILOT_LANG
# opts forwarded to the skill: --dry-run (plan only), --max-tasks N, --yes
# per-repo config: .autopilot.env at the repo root (set AUTOPILOT_* once)
set -uo pipefail
# Resolve through symlinks (the installer links this onto PATH) to find the repo.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
HERE="$(cd -P "$(dirname "$src")/.." && pwd)"
LIB="$HERE/lib"
# shellcheck source=lib/common.sh
. "$LIB/common.sh" || { echo "autopilot: cannot load $LIB/common.sh — broken install?" >&2; exit 1; }

# Per-repo config: set your AUTOPILOT_* options once in .autopilot.env at the repo
# root instead of prefixing every command. Use `: "${VAR:=value}"` lines so an
# inline env var still wins for a one-off. See .autopilot.env.example.
_ap_conf="$(ap_root 2>/dev/null)/.autopilot.env"
[ -f "$_ap_conf" ] && { set -a; . "$_ap_conf"; set +a; }

usage() { sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; }

cmd="${1:-help}"; shift 2>/dev/null || true

case "$cmd" in
  doctor)
    bash "$LIB/doctor.sh" "${1:-}" ;;

  run|supervise)
    goal="${1:?usage: autopilot $cmd \"<goal or file>\" [opts]}"; shift || true
    # Preflight gate: block only on hard blockers; pass --yes through.
    # --print-prompt and --lang are CLI-only; every other flag reaches the skill.
    yes=""; dry=""; fargs=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --yes)          yes="--yes"; fargs+=("$1") ;;
        --print-prompt) dry=1 ;;
        --lang)         export AUTOPILOT_LANG="${2:?--lang needs a value (e.g. fr)}"; shift ;;
        *)              fargs+=("$1") ;;
      esac
      shift
    done
    # --print-prompt touches nothing, so doctor is advisory: report, never block.
    bash "$LIB/doctor.sh" "$yes" || [ -n "$dry" ] \
      || ap_die "doctor blocked the run — fix the ✗ items above, or pass --yes" 3
    if [ "$cmd" = supervise ]; then
      bash "$LIB/supervisor.sh" "$goal" ${fargs[@]+"${fargs[@]}"}
    else
      why="$(ap_engine_available)" || ap_die "$why"
      pf="$(mktemp)"; trap 'rm -f "$pf"' EXIT
      ap_engine_prompt "$goal ${fargs[*]:-}" "$pf"
      if [ -n "$dry" ]; then
        echo; echo "--print-prompt — engine NOT started. It would receive:"; echo
        sed 's/^/  | /' "$pf"
        echo; echo "Drop --print-prompt to run it for real."; exit 0
      fi
      # The engine is headless: it prints nothing until it exits. Say so, and
      # log the session so `autopilot logs -f` works for run, not just supervise.
      out="$(ap_logs_dir)/session-$(date +%Y%m%d-%H%M%S).log"; mkdir -p "$(dirname "$out")"
      cat <<EOF

engine: $(ap_engine) — headless. It prints NOTHING until the whole run ends.
Follow it from another terminal, in this repo:
  autopilot status            task states as they land
  autopilot logs journal -f   decisions and gate results
  autopilot logs -f           this session log

EOF
      ap_engine_exec "$pf" 2>&1 | tee "$out"
    fi ;;

  resume)
    [ -d "$(ap_tasks_dir)" ] || ap_die "no run to resume here (.autopilot/tasks missing)"
    why="$(ap_engine_available)" || ap_die "$why"
    pf="$(mktemp)"; trap 'rm -f "$pf"' EXIT
    ap_engine_prompt "resume the run in .autopilot/ — read journal.md and state/*, restart at the first task not done. Do not start over." "$pf"
    ap_engine_exec "$pf" ;;

  status)
    # Per-task view: walk the queue, resolve each task's state, tally, print a table.
    sd="$(ap_task_state)"; qd="$(ap_tasks_dir)"
    st="$(cat "$(ap_status_file)" 2>/dev/null || echo NONE)"
    json="${1:-}"
    done=0; blocked=0; human=0; verify=0; todo=0; rows=""; jtasks=""
    icon() { case "$1" in done) echo "✓";; blocked) echo "✗";; needs-human) echo "⚑";; needs-verification) echo "⚠";; *) echo "·";; esac; }
    if [ -d "$qd" ]; then
      for f in "$qd"/*.md; do
        [ -e "$f" ] || continue
        base="$(basename "$f" .md)"
        title="$(sed -n '1s/^#[[:space:]]*//p' "$f")"; [ -n "$title" ] || title="$base"
        id="$(sed -n 's/^-[[:space:]]*\*\*id\*\*:[[:space:]]*//p' "$f" | head -1)"; [ -n "$id" ] || id="$base"
        gate="$(sed -n 's/^-[[:space:]]*\*\*gate\*\*:[[:space:]]*//p' "$f" | head -1 | tr -d '`')"
        tstate="todo"
        for key in "$id" "$base" "${base%%-*}"; do
          [ -n "$key" ] && [ -f "$sd/$key" ] && { tstate="$(cat "$sd/$key")"; break; }
        done
        case "$tstate" in done) done=$((done+1));; blocked) blocked=$((blocked+1));;
          needs-human) human=$((human+1));; needs-verification) verify=$((verify+1));;
          *) todo=$((todo+1)); tstate="todo";; esac
        rows="$rows$(printf '  %s  %-11s %s' "$(icon "$tstate")" "$tstate" "$title")
"
        jtasks="$jtasks,{\"id\":\"$id\",\"state\":\"$tstate\",\"title\":\"${title//\"/\'}\",\"gate\":\"${gate//\"/\'}\"}"
      done
    fi
    if [ "$json" = "--json" ]; then
      printf '{"status":"%s","done":%d,"blocked":%d,"needs_human":%d,"needs_verification":%d,"todo":%d,"tasks":[%s]}\n' \
        "$st" "$done" "$blocked" "$human" "$verify" "$todo" "${jtasks#,}"
    else
      echo "run status: $st"
      echo "$done done · $blocked blocked · $human needs-human · $verify needs-verification · $todo todo"
      [ -n "$rows" ] && { echo; printf '%s' "$rows"; }
      [ -d "$(ap_state_dir)/reports" ] && { echo; echo "per-task reports: $(ap_state_dir)/reports/ (INDEX.md)"; }
      [ -f "$(ap_inbox)" ] && { echo; echo "human inbox: $(ap_inbox)"; }
      true
    fi ;;

  scope)
    # autopilot scope <task-file.md> [git-ref]
    # Prints changed files outside the task's "## Allowed Files". Exit 2 if any.
    task="${1:?usage: autopilot scope <task-file.md> [git-ref]}"; ref="${2:-HEAD}"
    [ -f "$task" ] || ap_die "no such task file: $task"
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    ap_allowed_paths "$task" > "$tmp"
    [ -s "$tmp" ] || ap_die "task has no '## Allowed Files' paths — every task must declare its scope" 2
    v="$(ap_scope_violations "$tmp" "$ref")"
    if [ -n "$v" ]; then
      echo "SCOPE VIOLATION — changed outside ## Allowed Files:"; echo "$v" | sed 's/^/  /'
      exit 2
    fi
    echo "scope ok — all changes within ## Allowed Files" ;;

  gate-lint)
    # autopilot gate-lint <task-file.md>  — reject a weak/cheatable gate. Exit 2 if weak.
    task="${1:?usage: autopilot gate-lint <task-file.md>}"; [ -f "$task" ] || ap_die "no such task file: $task"
    g="$(ap_gate_of "$task")"
    if ap_gate_weak "$g"; then
      ap_warn "weak gate: \`${g:-<none>}\` — proves nothing. Use a real check (test -s, a passing test, tsc --noEmit, a smoke run)."
      exit 2
    fi
    echo "gate ok — \`$g\`" ;;

  gate)
    # autopilot gate <task-file.md> [--repo]  — run the task gate (or the repo gate).
    # Reproducible: from repo root, output to .autopilot/logs/, provenance to journal.
    task="${1:?usage: autopilot gate <task-file.md> [--repo]}"; [ -f "$task" ] || ap_die "no such task file: $task"
    if [ "${2:-}" = "--repo" ]; then
      g="$(ap_default_gate)"; [ -n "$g" ] || ap_die "no repo gate for this project type — rely on per-task gates" 2
      ap_run_gate "repo" "$g"; rc=$?
    else
      g="$(ap_gate_of "$task")"; [ -n "$g" ] || ap_die "task has no gate — not ready" 2
      ap_run_gate "$(ap_id_of "$task")" "$g"; rc=$?
    fi
    [ "$rc" -eq 0 ] && echo "gate PASS — \`$g\`" || echo "gate FAIL (exit $rc) — \`$g\` (see .autopilot/logs/)"
    [ "$rc" -eq 0 ] && gstate=pass || gstate=fail
    [ "${2:-}" = "--repo" ] && glabel=repo || glabel="$(ap_id_of "$task")"
    ap_event gate "gate $gstate — $glabel" \
      "$(printf 'gate: `%s`\nexit: %d\nlog: .autopilot/logs/gate-%s.log' "$g" "$rc" "$glabel")" \
      "$task" "$gstate" steps
    exit "$rc" ;;

  verify)
    # autopilot verify <task-file.md> [git-ref]  — the two-tier completion proof:
    # scope ⊆ Allowed Files, task gate green, AND the repo gate green (no wider break).
    task="${1:?usage: autopilot verify <task-file.md> [git-ref]}"; ref="${2:-HEAD}"
    [ -f "$task" ] || ap_die "no such task file: $task"
    fail=0
    # The inner gate calls log to events.log but must not double-push to channels;
    # verify emits its own single event below.
    "$0" scope "$task" "$ref"  >/dev/null 2>&1 && echo "  ✓ scope"      || { echo "  ✗ scope — changes outside ## Allowed Files"; fail=1; }
    AP_EVENT_SUPPRESS=1 "$0" gate  "$task"         >/dev/null 2>&1 && echo "  ✓ task gate"  || { echo "  ✗ task gate failed"; fail=1; }
    if [ -n "$(ap_default_gate)" ]; then
      AP_EVENT_SUPPRESS=1 "$0" gate "$task" --repo >/dev/null 2>&1 && echo "  ✓ repo gate"  || { echo "  ✗ repo gate failed — the change broke the wider build/tests"; fail=1; }
    else
      echo "  · repo gate skipped (no default for this project type)"
    fi
    [ "$fail" -eq 0 ] && vstate=pass || vstate=fail
    ap_event verify "verify $vstate — $(ap_id_of "$task")" \
      "scope + task gate + repo gate: $vstate" "$task" "$vstate" steps
    [ "$fail" -eq 0 ] && { echo "verify PASS"; exit 0; } || { echo "verify FAIL"; exit 2; }
    ;;

  needs-verify)
    # autopilot needs-verify <task-file.md>  — documented gate bypass.
    # Use ONLY when the automated gate genuinely cannot prove completion here
    # (needs a live app, e2e, a test account, or a human's eyes). It refuses
    # unless the task documents a "## Manual Verification" section, records a
    # clear human item to .autopilot/inbox.md, and fires a notification —
    # so the work is never silently accepted, always surfaced for a human.
    task="${1:?usage: autopilot needs-verify <task-file.md>}"; [ -f "$task" ] || ap_die "no such task file: $task"
    steps="$(ap_manual_steps "$task")"
    [ -n "$steps" ] || ap_die "refusing to bypass: the task has no '## Manual Verification' section documenting what a human must check" 2
    id="$(ap_id_of "$task")"
    mkdir -p "$(ap_task_state)"; echo needs-verification > "$(ap_task_state)/$id"
    ap_inbox_action "$task" "⚠" \
      "Manually verify this task — the code is committed, but the automated gate cannot prove it in this environment." \
      "The task's gate needs something not available headless (a live app, an e2e/browser run, a test account, or a human's eyes)." \
      "$steps"
    ap_log "needs-verification: $id (clear manual item queued to inbox)"
    ap_event needs-verification "$id — manual verify" \
      "automated gate can't prove it; see .autopilot/inbox.md" "$task" needs-verification milestones
    echo "recorded needs-verification for $id — human item in $(ap_inbox)" ;;

  report)
    # autopilot report <task.md> --state S --did "..." --why "..." [--how "..."] [--notes "..."]
    # Writes a uniform per-task report to .autopilot/reports/<id>.md (what was
    # done, how, why + gate/commit/files) so every task leaves the same readable
    # trail. --state/--did/--why are required; the rest are filled from the task.
    task="${1:?usage: autopilot report <task.md> --state S --did ... --why ...}"; shift || true
    [ -f "$task" ] || ap_die "no such task file: $task"
    r_state=""; r_did=""; r_why=""; r_how=""; r_notes=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --state) r_state="${2:-}"; shift 2 ;;
        --did)   r_did="${2:-}";   shift 2 ;;
        --why)   r_why="${2:-}";   shift 2 ;;
        --how)   r_how="${2:-}";   shift 2 ;;
        --notes) r_notes="${2:-}"; shift 2 ;;
        *) ap_die "report: unknown option '$1'" 2 ;;
      esac
    done
    [ -n "$r_state" ] || ap_die "report: --state is required (done|blocked|needs-human|needs-verification)" 2
    [ -n "$r_did" ]   || ap_die "report: --did is required (what was actually done)" 2
    [ -n "$r_why" ]   || ap_die "report: --why is required (why it was done this way)" 2
    f="$(ap_report "$task" "$r_state" "$r_did" "$r_why" "$r_how" "$r_notes")"
    echo "wrote $f"
    # Per-step event carrying the FULL report as the body (Telegram renders it).
    evt_kind=task-done; evt_lvl=steps
    case "$r_state" in
      blocked)            evt_kind=blocked;            evt_lvl=milestones ;;
      needs-human)        evt_kind=needs-human;        evt_lvl=milestones ;;
      needs-verification) evt_kind=needs-verification; evt_lvl=milestones ;;
    esac
    ap_event "$evt_kind" "$(ap_id_of "$task") — $r_state" "$(cat "$f")" "$task" "$r_state" "$evt_lvl" ;;

  inbox)
    # autopilot inbox <task.md> --do "..." --why "..." [--how "..."] [--unblocks "..."] [--icon X]
    # Appends a clear human item (what to do, why, how, what it unblocks) and
    # notifies. Use for blocked / needs-human items so a human can act without
    # digging through logs. --do and --why are required.
    task="${1:?usage: autopilot inbox <task.md> --do ... --why ...}"; shift || true
    [ -f "$task" ] || ap_die "no such task file: $task"
    i_do=""; i_why=""; i_how=""; i_unblocks=""; i_icon="⚑"
    while [ $# -gt 0 ]; do
      case "$1" in
        --do)       i_do="${2:-}";       shift 2 ;;
        --why)      i_why="${2:-}";      shift 2 ;;
        --how)      i_how="${2:-}";      shift 2 ;;
        --unblocks) i_unblocks="${2:-}"; shift 2 ;;
        --icon)     i_icon="${2:-⚑}";    shift 2 ;;
        *) ap_die "inbox: unknown option '$1'" 2 ;;
      esac
    done
    [ -n "$i_do" ]  || ap_die "inbox: --do is required (the exact action a human must take)" 2
    [ -n "$i_why" ] || ap_die "inbox: --why is required (why it needs a human)" 2
    ap_inbox_action "$task" "$i_icon" "$i_do" "$i_why" "$i_how" "$i_unblocks"
    ap_event needs-human "$(ap_id_of "$task") — action needed" \
      "$(printf '%s\n\n%s' "$i_do" "$i_why")" "$task" needs-human milestones
    echo "queued a human item to $(ap_inbox)" ;;

  revert)
    # autopilot revert <task-file.md>  — restore ONLY the task's Allowed Files (scoped
    # revert, never a global reset), so a rejected task leaves no half-done work.
    task="${1:?usage: autopilot revert <task-file.md>}"; [ -f "$task" ] || ap_die "no such task file: $task"
    paths="$(ap_allowed_paths "$task")"; [ -n "$paths" ] || ap_die "task has no ## Allowed Files to revert" 2
    echo "$paths" | while IFS= read -r p; do [ -n "$p" ] && git checkout -- "$p" 2>/dev/null; done
    echo "reverted the task's Allowed Files to HEAD" ;;

  review)
    # autopilot review <task-file.md> [git-ref]  — independent JSON verdict.
    # Exit 10 = no external reviewer configured; caller uses the subagent instead
    # (no capturable verdict then → no review event).
    out="$(bash "$LIB/review.sh" "$@")"; rc=$?
    if [ "$rc" -eq 0 ]; then
      rv="$(printf '%s' "$out" | sed -n 's/.*"status"[[:space:]]*:[[:space:]]*"\([A-Z_]*\)".*/\1/p' | head -1)"
      [ "$rv" = RISKY ] && rlvl=milestones || rlvl=steps
      ap_event review "review: ${rv:-?} — $(ap_id_of "${1:-}" 2>/dev/null || echo "${1:-}")" "$out" "${1:-}" "$rv" "$rlvl"
    fi
    printf '%s\n' "$out"; exit "$rc" ;;

  event)
    # autopilot event <kind> <title> [body] [--task f] [--state s] [--level l] [--body b]
    # Structured per-step event: always logged to .autopilot/events.log + journal,
    # pushed to channels when AUTOPILOT_NOTIFY_LEVEL allows the event's level.
    e_kind="${1:?usage: autopilot event <kind> <title> [body] [--task f] [--state s] [--level l]}"; shift || true
    e_title="${1:?usage: autopilot event <kind> <title> [body] ...}"; shift || true
    e_body=""; e_task=""; e_state=""; e_level=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --task)  e_task="${2:-}";  shift 2 ;;
        --state) e_state="${2:-}"; shift 2 ;;
        --level) e_level="${2:-}"; shift 2 ;;
        --body)  e_body="${2:-}";  shift 2 ;;
        --*)     ap_die "event: unknown option '$1'" 2 ;;
        *)       [ -z "$e_body" ] && e_body="$1" || e_body="$e_body $1"; shift ;;
      esac
    done
    ap_event "$e_kind" "$e_title" "$e_body" "$e_task" "$e_state" "$e_level"
    echo "event $e_kind logged" ;;

  docs)
    # autopilot docs [status|init]  — the durable-doc quad (committed source of truth).
    bash "$LIB/docs.sh" "$@" ;;

  init)
    # autopilot init  — scaffold the editable project instructions, then let the
    # user fill them BEFORE running. Never clobbers a file that already has content.
    root="$(ap_root)"
    echo "autopilot init — $root"
    # 1. CLAUDE.md: coding rules every subagent (and Claude Code) reads automatically.
    cm="$root/CLAUDE.md"
    if [ -s "$cm" ]; then echo "  • CLAUDE.md exists — kept"
    else
      cat > "$cm" <<'EOF'
# CLAUDE.md — project rules for autopilot & Claude Code

<!-- Edit before running autopilot. Every subagent (builder, reviewer) reads this
     automatically. Keep it about HOW to build; put WHAT to build in docs/autopilot/. -->

## Stack
<!-- languages, frameworks, key libraries, package manager, run/build/test commands -->

## Conventions
<!-- naming, file/folder layout, error handling, formatting, imports -->

## Boundaries
<!-- module isolation, what may import what, layering rules, public vs internal -->

<!-- Project "never do" constraints live in docs/autopilot/requirements.md
     (## Constraints), the committed source of truth autopilot reads and passes
     to every builder. Keep this file about how to code. -->
EOF
      echo "  ✓ scaffolded CLAUDE.md"
    fi
    # 2. the durable-doc quad (what to build): reuse docs init.
    bash "$LIB/docs.sh" init
    # 3. per-repo config (once), and ignore the local workspace + config.
    env="$root/.autopilot.env"; ex="$HERE/.autopilot.env.example"
    if [ -s "$env" ]; then echo "  • .autopilot.env exists — kept"
    elif [ -f "$ex" ]; then cp "$ex" "$env"; echo "  ✓ scaffolded .autopilot.env (edit lang/model/notify)"
    fi
    gi="$root/.gitignore"
    grep -q '^\.autopilot/' "$gi" 2>/dev/null || printf '\n# autopilot\n.autopilot/\n.autopilot.env\n' >> "$gi"
    echo
    echo "Next: edit CLAUDE.md and docs/autopilot/*.md to dictate the project,"
    echo "then run:  autopilot supervise \"<your goal>\""
    echo "autopilot reads them as the source of truth and builds to them." ;;

  logs)
    # autopilot logs [what] [-f|-n N]
    #   (default)   the newest engine session log — what Claude/Codex actually did
    #   supervisor  the supervisor's own log (sessions, quota waits)
    #   gate[-<id>] a gate's captured output
    #   journal     the decision journal
    #   ls          list every log with size and time
    ld="$(ap_logs_dir)"; what="${1:-session}"; case "$what" in -*) what=session;; *) shift 2>/dev/null || true;; esac
    follow=""; lines=200
    while [ $# -gt 0 ]; do
      case "$1" in
        -f|--follow) follow=1 ;;
        -n) shift; lines="${1:-200}" ;;
        -n*) lines="${1#-n}" ;;
      esac; shift
    done
    [ -d "$ld" ] || ap_die "no logs yet ($ld) — run 'autopilot supervise' or a gate first"
    case "$what" in
      ls|list)
        # Newest last, with size — the quickest way to see what a run produced.
        ls -lhtr "$ld" 2>/dev/null | sed '1d;s/^/  /'
        [ -f "$(ap_journal)" ] && printf '  %s\n' "$(ls -lh "$(ap_journal)" | sed 's/^/journal: /')"
        true ;;
      journal)
        f="$(ap_journal)"; [ -f "$f" ] || ap_die "no journal yet ($f)"
        [ -n "$follow" ] && exec tail -f "$f" || tail -n "$lines" "$f" ;;
      *)
        # Resolve to a concrete file: an exact name, else the newest match for the prefix.
        if [ -f "$ld/$what" ]; then f="$ld/$what"
        elif [ -f "$ld/$what.log" ]; then f="$ld/$what.log"
        else f="$(ls -t "$ld"/${what}*.log 2>/dev/null | head -1)"; fi
        [ -n "${f:-}" ] && [ -f "$f" ] || ap_die "no log matching '$what' in $ld (try: autopilot logs ls)"
        echo "── $f" >&2
        [ -n "$follow" ] && exec tail -f "$f" || tail -n "$lines" "$f" ;;
    esac ;;

  notify)
    # autopilot notify "<title>" "<body>"  — fire a milestone notification (test the hook).
    ap_notify "${1:-autopilot}" "${2:-}" ;;

  update|upgrade)
    # Pull the latest into the install dir (HERE is resolved through the symlink),
    # then re-link so new agents/lib land and extras refresh.
    git -C "$HERE" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      || ap_die "install dir is not a git repo: $HERE — reinstall via the curl one-liner"
    before="$(git -C "$HERE" rev-parse --short HEAD 2>/dev/null)"
    echo "updating $HERE"
    git -C "$HERE" pull --ff-only || ap_die "pull failed (local changes in $HERE?) — stash or reinstall"
    after="$(git -C "$HERE" rev-parse --short HEAD 2>/dev/null)"
    if [ "$before" = "$after" ]; then echo "already up to date ($after)"
    else echo "updated $before → $after"; fi
    bash "$HERE/install.sh" ;;

  help|-h|--help) usage ;;
  *) ap_warn "unknown command: $cmd"; usage; exit 1 ;;
esac
